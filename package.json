{
  "name": "elden-ring-tracker",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:server": "npx esbuild server/index.ts --bundle --platform=node --target=node18 --outfile=server/server.bundle.cjs",
    "build:tracker": "C:\\Windows\\Microsoft.NET\\Framework64\\v4.0.30319\\csc.exe /nologo /optimize+ /target:winexe /out:tools\\er_tracker.exe tools\\er_tracker\\Program.cs",
    "build:launcher": "C:\\Windows\\Microsoft.NET\\Framework64\\v4.0.30319\\csc.exe /nologo /optimize+ /target:winexe /win32icon:launcher\\app.ico /r:System.Windows.Forms.dll /r:System.Drawing.dll /out:launcher\\EldenRingTracker.exe launcher\\Program.cs",
    "package": "powershell -ExecutionPolicy Bypass -File ./scripts/package.ps1",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "aes-js": "^3.1.2",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/aes-js": "^3.1.4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
